# Google Cloud service account with Sheets API enabled, and the target
# spreadsheet shared with the service account's email as an Editor.

GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Paste the private_key value from your service account JSON key.
# Keep it on one line with literal \n for newlines, wrapped in quotes:
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# Single-tenant fallback sheet. Used only when CONTROL_SHEET_ID (below) is NOT
# set -- i.e. the app behaves exactly as before, one sheet for everyone.
GOOGLE_SHEET_ID=1CJi6863WLGR6H8sO-S3C8LZznrPwLcBbbpMEm9aqqGE

# --- Multi-tenant (God Mode) ---
# Master "Control" spreadsheet you own, containing a "Tenants" tab that lists
# every customer (see lib/tenancy.ts for the column layout). Leave BLANK to run
# in single-tenant mode using GOOGLE_SHEET_ID above.
CONTROL_SHEET_ID=

# Pipe-separated developer emails that get God Mode (manage all tenants, switch
# between customer workspaces). Example: you@gmail.com|partner@gmail.com
DEVELOPER_EMAILS=

# --- Real Google Sign-In (NextAuth.js) ---
# This is a DIFFERENT kind of credential than the service account above --
# that one lets the SERVER read/write your spreadsheet; these let a PERSON
# sign in with their own Google account. Both live in the same Google Cloud
# project (mykabayan-tracker), just a different page.

# Any random long string works -- used to encrypt session cookies.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-string

# Must match exactly where the app is running.
NEXTAUTH_URL=http://localhost:3000

# From Google Cloud Console -> APIs & Services -> Credentials ->
# Create Credentials -> OAuth client ID -> Web application.
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
